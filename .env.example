# ===================================================================
# Google Firebase Phone Authentication (Free 10,000 SMS / Month)
# ===================================================================
# 1. Go to https://console.firebase.google.com
# 2. Create a free project (e.g. "Old Money Atelier")
# 3. Under Build -> Authentication -> Sign-in method -> Click "Phone" and enable it
# 4. Under Project Settings -> Your Apps -> Add Web App (</>)
# 5. Copy your 6 config values here:

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
